# Installed by admin/install_cluster_status_collector.sh, which fills in the repository path.
[Unit]
Description=rota cluster status collector (dashboard snapshot)
Documentation=file://@REPO_DIR@/docs/operations.md

[Service]
Type=simple
ExecStart=/usr/bin/python3 @REPO_DIR@/monitor/cluster_status_collector.py
Restart=always
RestartSec=10
Nice=10
CPUQuota=20%
MemoryMax=256M
UMask=0077

[Install]
WantedBy=default.target
